# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=aws_framework
DATABASE_USER=framework_user
DATABASE_PASSWORD=framework_password

# Application Configuration
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=info

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=aws-framework
KEYCLOAK_CLIENT_ID=aws-framework-backend
KEYCLOAK_CLIENT_SECRET=your-client-secret

# Keycloak Admin Configuration
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=your-admin-client-secret
KEYCLOAK_ADMIN_BASE_URL=http://localhost:8080
KEYCLOAK_ADMIN_REALM=aws-framework

# Lets the backend check a member's current password when they change their
# password or email address from the account app (P4/P5). Keycloak's Admin API
# can set a password but cannot verify one, so this client exists to attempt a
# direct-grant login. Confidential and direct-grant only — never the public
# account-app client. Created by `npm run seed`.
KEYCLOAK_PASSWORD_CHECK_CLIENT_ID=account-password-check
KEYCLOAK_PASSWORD_CHECK_CLIENT_SECRET=account-password-check-dev-secret

# AWS Configuration (for production)
AWS_REGION=eu-west-1
AWS_SECRETS_ARN=

# Monitoring
PROMETHEUS_PORT=9091

# --- Stripe (platform account, not a club's) ---------------------------------
# Charges are Connect destination charges made on the PLATFORM account, with the
# handling fee taken as an application fee. These are the platform's own
# credentials; each organisation stores only its connected account id in
# settings.payment.stripeAccountId.
# See docs/ACCOUNT_USER_APP_PHASE8_CHECKOUT.md §1.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Ticket QR signing -------------------------------------------------------
# What a ticket's QR code carries. Unset, tickets carry the plain identifier
# they always did and everything still works — a gate simply cannot tell a
# forged code from an unknown one until it asks the server.
#
# Set, the QR carries a signed token: the identifier plus the event and the
# expiry, with an HMAC over them. The key **never leaves the server** — nothing
# else needs it, because a scanner offline recognises our codes from the
# manifest it downloaded, and online we verify.
#
# Format: `id:secret` pairs, comma separated, MOST RECENT FIRST. The first
# signs; all of them verify, which is what makes the key rotatable without
# invalidating tickets already in people's inboxes. Ids are 1-255; secrets are
# base64 and must decode to at least 32 bytes.
#
#   openssl rand -base64 32
#   TICKET_SIGNING_KEYS=2:<new>,1:<previous>
#
# Retire an old key only once every ticket it signed has expired. See
# docs/SIGNED_TICKET_CODES.md.
TICKET_SIGNING_KEYS=

# --- Rate limiting -----------------------------------------------------------
# Each limit is requests per window, and the shipped defaults apply when these
# are unset. Raise them for a host that sits behind a shared address — every
# caller through one NAT or proxy counts as one client, because the key is the
# remote address.
#   RATE_LIMIT_API_MAX        all /api routes          (default 100 / minute)
#   RATE_LIMIT_AUTH_MAX       failed sign-ins          (default 5 / 15 minutes)
#   RATE_LIMIT_UPLOAD_MAX     file uploads             (default 10 / minute)
#   RATE_LIMIT_EXPENSIVE_MAX  reports and exports      (default 5 / minute)
RATE_LIMIT_API_MAX=
RATE_LIMIT_AUTH_MAX=
RATE_LIMIT_UPLOAD_MAX=
RATE_LIMIT_EXPENSIVE_MAX=
