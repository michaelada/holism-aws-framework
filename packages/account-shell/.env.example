# Backend API (proxied to localhost:3000 in development)
VITE_API_BASE_URL=

# Keycloak
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=aws-framework
VITE_KEYCLOAK_CLIENT_ID=account-app

# Stripe — the PLATFORM's publishable key, not a club's.
# Charges are Connect destination charges on the platform account; the club's
# connected account id lives server-side in settings.payment.stripeAccountId.
# See docs/ACCOUNT_USER_APP_PHASE8_CHECKOUT.md §1.
VITE_STRIPE_PUBLISHABLE_KEY=
