# Single-instance deployment — copy to `.env.deploy` on the box and fill in.
#
# `scripts/deploy/bootstrap.sh` generates the secrets and writes this file for
# you on first boot; this template is here so the shape is reviewable, and for
# deploying by hand.
#
# See docs/DEPLOY_SINGLE_INSTANCE.md.

# ---------------------------------------------------------------------------
# Where this deployment lives
# ---------------------------------------------------------------------------
# The scheme and host the browser will use. Baked into the front-end bundles at
# image build time, so changing it means rebuilding `web`.
PUBLIC_URL=https://test.example.com
# The bare host, for Keycloak's hostname handling.
PUBLIC_HOST=test.example.com

# ---------------------------------------------------------------------------
# Database — lives in a container on this box, not RDS
# ---------------------------------------------------------------------------
DATABASE_NAME=aws_framework
DATABASE_USER=framework_user
DATABASE_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Keycloak
# ---------------------------------------------------------------------------
KEYCLOAK_REALM=aws-framework
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# These three must match the realm import. The bootstrap script substitutes the
# generated values into `infrastructure/keycloak/realm-import.json` before
# Keycloak first starts, because a realm is imported once and ignored after.
KEYCLOAK_BACKEND_SECRET=CHANGE_ME
KEYCLOAK_SERVICE_ACCOUNT_SECRET=CHANGE_ME
# Without this, every password check fails and members are told a correct
# password is wrong. See docs/ACCOUNT_SELF_SERVICE_CREDENTIALS.md.
KEYCLOAK_PASSWORD_CHECK_SECRET=CHANGE_ME

# How much of the box the JVM may take. On a 2 GB instance drop this to 700m and
# expect Keycloak to be the first thing that struggles.
KEYCLOAK_MEM_LIMIT=1200m

# ---------------------------------------------------------------------------
# Email — the platform sends registration, credential and payment mail
# ---------------------------------------------------------------------------
AWS_REGION=eu-west-1
SES_FROM_EMAIL=noreply@example.com

# ---------------------------------------------------------------------------
# Stripe — optional. Payments simply refuse without them.
# ---------------------------------------------------------------------------
# Use TEST keys here. The seed refuses to touch a live account, and a test
# deployment taking real money is the worst possible outcome of a demo.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# How long a Stripe webhook may take before the server answers without waiting
# for it (milliseconds, default 10000). Stripe abandons a delivery at about 20
# seconds and records a timeout, so this must stay comfortably below that.
# Lower it if the database is slow; the work still finishes in the background
# and Stripe's redelivery finds it done. See docs/STRIPE_WEBHOOK_TIMEOUTS.md.
#WEBHOOK_RESPONSE_DEADLINE_MS=10000

# Signs the token in every ticket's QR code. Generate with
# `openssl rand -base64 32`, then set as `1:<secret>`; rotate by prepending a
# new pair, `2:<new>,1:<previous>`, and retiring the old one once every ticket
# it signed has expired. Unset, tickets carry the plain identifier they always
# did. See docs/SIGNED_TICKET_CODES.md.
TICKET_SIGNING_KEYS=

LOG_LEVEL=info
