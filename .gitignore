# Dependencies
node_modules/

# Lockfiles are NOT ignored, and this matters.
#
# They were, and it broke deployment: the instance clones this repository and
# builds from source, so a lockfile that exists only on a developer's machine
# is a lockfile the build cannot see. `npm ci` — used by both images — requires
# one and fails outright without it.
#
# Committing them is also the point of having them. An application's build
# should resolve the same dependency versions everywhere; ignoring the lockfile
# means the deployed bundle can be built from different packages than the ones
# that were tested. (Libraries sometimes omit them. This is not a library.)
#
# yarn/pnpm stay ignored — this workspace uses npm, and a stray lockfile from
# another package manager would only confuse.
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
build/
coverage/
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*

# Single-instance deployment: generated on the box, never committed
.env.deploy
infrastructure/keycloak/realm-import.rendered.json
.deploy/
.deploy-source

# OpenTofu/Terraform working directory. Holds provider binaries — the AWS
# provider alone is ~650 MB, which GitHub refuses outright (100 MB limit).
# `.terraform.lock.hcl` is deliberately NOT ignored: it pins provider versions
# and belongs in the repository.
.terraform/
